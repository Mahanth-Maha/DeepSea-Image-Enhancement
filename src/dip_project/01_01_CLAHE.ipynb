    "import numpy as np\n",
    "from numpy.fft import fft2, ifft2, fftshift, ifftshift\n",
    "from sklearn.metrics import mean_squared_error\n",
    "\n",
    "def wiener_restore(g, h, K=1e-3, eps=1e-12):  # sourcery skip: extract-method\n",
    "    \"\"\"\n",
    "    g : degraded image (2D or 3D numpy array, float)\n",
    "    h : PSF kernel (small 2D numpy array)\n",
    "    K : noise/signal power ratio (scalar). smaller K = more aggressive restore.\n",
    "    eps : numeric floor to avoid div-by-zero.\n",
    "    Returns restored image (real-valued).\n",
    "    \"\"\"\n",
    "    # color image\n",
    "    M, N, c = g.shape\n",
    "    f_hat = np.zeros_like(g, dtype=float)\n",
    "    kh, kw = h.shape\n",
    "    for channel in range(c):\n",
    "        h_padded = np.zeros((M, N), dtype=float)\n",
    "        top = (M - kh) // 2\n",
    "        left = (N - kw) // 2\n",
    "        h_padded[top:top+kh, left:left+kw] = h\n",
    "        h_padded = ifftshift(h_padded)\n",
    "        G = fft2(g[:, :, channel])\n",
    "        H = fft2(h_padded)\n",
    "        H_conj = np.conj(H)\n",
    "        denom = (np.abs(H)**2) + K + eps\n",
    "        W = H_conj / denom\n",
    "        F_hat = W * G\n",
    "        f_hat[:, :, channel] = np.real(ifft2(F_hat))\n",
    "    return f_hat"
